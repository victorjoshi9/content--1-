NIM_API_KEY=
NVIDIA_NIM_API_KEY=
NIM_API_HOST=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_TASK=qwen_code_cli

# GGUF storage pipeline (S3-compatible or E2B-style storage API)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=your-model-bucket
STORAGE_PREFIX=gguf-models
AWS_REGION=auto
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional E2B upload settings (if using custom E2B storage API endpoint)
E2B_API_KEY=
E2B_STORAGE_API_BASE=

AI_PROVIDER=nim
OUTPUT_FORMAT=text
DISABLE_COLORS=false
