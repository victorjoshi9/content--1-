# 1) Your API key (set this first)
E2B_API_KEY=

# 2) Local Sandbox API
SANDBOX_API_PORT=8787

# 3) Local cloud object storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=trconnects-models
MINIO_REGION=us-east-1

# 4) Local data store (PostgreSQL)
POSTGRES_DB=trconnects
POSTGRES_USER=trconnects
POSTGRES_PASSWORD=trconnects123
POSTGRES_PORT=5434

# 5) Sandbox service ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
